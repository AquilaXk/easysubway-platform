{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform activation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "orchestrator",
    "operation",
    "tuple",
    "bindings",
    "candidate",
    "activation",
    "termination",
    "cleanup",
    "fallbackZero",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "PLATFORM_ACTIVATION_RECEIPT_V2"
    },
    "artifactKind": {
      "type": "string",
      "const": "platform-activation-receipt"
    },
    "orchestrator": {
      "type": "string",
      "const": "COMPOSE"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "hostIdentity",
        "deployLockPath",
        "deployLockEvidenceDigest"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,255}(?![\\s\\S])"
        },
        "hostIdentity": {
          "type": "string",
          "const": "oci-host-easysubway-a1"
        },
        "deployLockPath": {
          "type": "string",
          "const": "${DEPLOY_ROOT}/deploy.lock"
        },
        "deployLockEvidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "tuple": {
      "$ref": "journey-release-tuple.schema.json"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataDescriptorSha256",
        "tupleSha256",
        "candidateBindingSha256",
        "descriptorBindingSha256",
        "candidateAdmissionSha256"
      ],
      "properties": {
        "dataDescriptorSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "tupleSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "candidateBindingSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "descriptorBindingSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "candidateAdmissionSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceCount",
        "failureDomainCount",
        "instanceIdentity",
        "failureDomainIdentity",
        "baseUrl",
        "candidateGeneration",
        "allReady",
        "allInstancesMatchTuple",
        "canaryPassed",
        "canaryEvidenceDigest",
        "standbyActiveReadinessEvidenceDigest"
      ],
      "properties": {
        "instanceCount": {
          "type": "integer",
          "const": 1
        },
        "failureDomainCount": {
          "type": "integer",
          "const": 1
        },
        "instanceIdentity": {
          "type": "string",
          "const": "backend-standby"
        },
        "failureDomainIdentity": {
          "type": "string",
          "const": "oci-host-easysubway-a1"
        },
        "baseUrl": {
          "type": "string",
          "const": "http://127.0.0.1:8082"
        },
        "candidateGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "allReady": {
          "type": "boolean",
          "const": true
        },
        "allInstancesMatchTuple": {
          "type": "boolean",
          "const": true
        },
        "canaryPassed": {
          "type": "boolean",
          "const": true
        },
        "canaryEvidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "standbyActiveReadinessEvidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trafficGeneration",
        "standbySwitch",
        "canonicalActiveReadinessEvidenceDigest",
        "canonicalSwitch"
      ],
      "properties": {
        "trafficGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "standbySwitch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromPort",
            "toPort",
            "nginxConfigSha256",
            "nginxTestPassed",
            "reloadCompleted",
            "evidenceDigest"
          ],
          "properties": {
            "fromPort": { "type": "integer", "const": 8080 },
            "toPort": { "type": "integer", "const": 8082 },
            "nginxConfigSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
            "nginxTestPassed": { "type": "boolean", "const": true },
            "reloadCompleted": { "type": "boolean", "const": true },
            "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" }
          }
        },
        "canonicalActiveReadinessEvidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "canonicalSwitch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromPort",
            "toPort",
            "nginxConfigSha256",
            "nginxTestPassed",
            "reloadCompleted",
            "evidenceDigest"
          ],
          "properties": {
            "fromPort": { "type": "integer", "const": 8082 },
            "toPort": { "type": "integer", "const": 8080 },
            "nginxConfigSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" },
            "nginxTestPassed": { "type": "boolean", "const": true },
            "reloadCompleted": { "type": "boolean", "const": true },
            "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" }
          }
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "stopGracePeriodSeconds",
        "newRequestAdmissionAfterSignal",
        "inFlightSnapshotPinned",
        "inFlightCompleted",
        "oldProcessExited",
        "withinBudget",
        "droppedJourneyCount",
        "duplicateJourneyCount",
        "evidenceDigest"
      ],
      "properties": {
        "signal": { "type": "string", "const": "SIGTERM" },
        "stopGracePeriodSeconds": { "type": "integer", "const": 30 },
        "newRequestAdmissionAfterSignal": { "type": "integer", "const": 0 },
        "inFlightSnapshotPinned": { "type": "boolean", "const": true },
        "inFlightCompleted": { "type": "boolean", "const": true },
        "oldProcessExited": { "type": "boolean", "const": true },
        "withinBudget": { "type": "boolean", "const": true },
        "droppedJourneyCount": { "type": "integer", "const": 0 },
        "duplicateJourneyCount": { "type": "integer", "const": 0 },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standbyRemoved",
        "orphanedStandbyCount",
        "evidenceDigest"
      ],
      "properties": {
        "standbyRemoved": { "type": "boolean", "const": true },
        "orphanedStandbyCount": { "type": "integer", "const": 0 },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" }
      }
    },
    "fallbackZero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyGraphSuccessCount",
        "localRouteInvocationCount",
        "staleJourneyServedCount",
        "alternateEndpointSuccessCount"
      ],
      "properties": {
        "legacyGraphSuccessCount": { "type": "integer", "const": 0 },
        "localRouteInvocationCount": { "type": "integer", "const": 0 },
        "staleJourneyServedCount": { "type": "integer", "const": 0 },
        "alternateEndpointSuccessCount": { "type": "integer", "const": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "runUrl"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9]{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
        },
        "runUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/AquilaXk/easysubway-platform/actions/runs/[1-9][0-9]*(?![\\s\\S])"
        }
      }
    }
  }
}
