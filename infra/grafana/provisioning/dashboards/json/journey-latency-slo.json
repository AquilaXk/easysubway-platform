{
  "uid": "easysubway-journey-latency-slo",
  "title": "Journey 검색 지연 SLO",
  "tags": [
    "easysubway",
    "journey",
    "slo",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLI 달성률 (선택 기간, 모드별)",
      "description": "임계 시간 안에 끝난 ok·no_route 검색 비율. 목표 99%. 임계: depart_at 25 ms, arrive_by·last_connection 250 ms, depart_between 500 ms. 계산 가능한 기간은 Prometheus 보존 기간까지다.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "easysubway-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (mode) (rate(easysubway_journey_search_duration_seconds_bucket{job=\"backend_app_metrics\",mode=\"depart_at\",outcome=~\"ok|no_route\",le=\"0.025\"}[$__range])) or sum by (mode) (rate(easysubway_journey_search_duration_seconds_bucket{job=\"backend_app_metrics\",mode=~\"arrive_by|last_connection\",outcome=~\"ok|no_route\",le=\"0.25\"}[$__range])) or sum by (mode) (rate(easysubway_journey_search_duration_seconds_bucket{job=\"backend_app_metrics\",mode=\"depart_between\",outcome=~\"ok|no_route\",le=\"0.5\"}[$__range]))) / sum by (mode) (rate(easysubway_journey_search_duration_seconds_count{job=\"backend_app_metrics\",outcome=~\"ok|no_route\"}[$__range]))",
          "legendFormat": "{{mode}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "불량 비율 (5m·1h, 모드별) — 오류 예산 1%",
      "description": "임계 시간을 넘긴 ok·no_route 검색의 비율. 1%를 넘는 상태가 지속되면 오류 예산이 소진된다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "easysubway-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate5m",
          "legendFormat": "{{mode}} 5m",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate1h",
          "legendFormat": "{{mode}} 1h",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "burn rate (오류 예산 0.01, 모드별)",
      "description": "불량 비율 / 0.01. 경보 기준: Critical 14.4x(1h·5m), Warning 6x(6h·30m), Ticket 1x(3d·6h).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "easysubway-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate5m / 0.01",
          "legendFormat": "{{mode}} 5m",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate1h / 0.01",
          "legendFormat": "{{mode}} 1h",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate6h / 0.01",
          "legendFormat": "{{mode}} 6h",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "D",
          "expr": "easysubway:journey_search_latency_bad_ratio:rate3d / 0.01",
          "legendFormat": "{{mode}} 3d",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 근사 (히스토그램 버킷 보간, 모드별)",
      "description": "버킷 경계(10·25·50·100·250·500·1000·2500 ms) 사이를 선형 보간한 값이라 버킷 폭만큼 오차가 있다. SLO 판정에는 쓰지 않는다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "easysubway-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, mode) (rate(easysubway_journey_search_duration_seconds_bucket{job=\"backend_app_metrics\",outcome=~\"ok|no_route\"}[$__rate_interval])))",
          "legendFormat": "{{mode}} p99",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "요청량 (모드·결과별, req/s)",
      "description": "무트래픽(0)과 지표 누락(시계열 없음)은 다르다. 시계열이 없으면 BackendJourneyLatencySliMissing 경보가 발화한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "easysubway-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, outcome) (rate(easysubway_journey_search_duration_seconds_count{job=\"backend_app_metrics\"}[$__rate_interval]))",
          "legendFormat": "{{mode}} {{outcome}}",
          "editorMode": "code",
          "range": true
        }
      ]
    }
  ]
}
