limit_req_zone $binary_remote_addr zone=easysubway_journey:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=easysubway_upload:10m rate=1r/s;
limit_req_zone $binary_remote_addr zone=easysubway_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=easysubway_conn:10m;

map $status $easysubway_edge_loggable {
    default 0;
    429 1;
    "~^5" 1;
}

map $uri $easysubway_edge_location {
    default "api";
    "~^/api/v3/journeys/" "journey";
    "~^/api/v1/report-uploads" "upload";
    "~^/api/v1/reports" "upload";
    "~^/actuator" "actuator";
    "~^/\.well-known/" "acme";
}

log_format easysubway_edge_json escape=json
    '{"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"status":"$status",'
    '"method":"$request_method",'
    '"path":"$uri",'
    '"location":"$easysubway_edge_location",'
    '"request_time":"$request_time"}';

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name easysubway-api.aquilaxk.site;
    server_tokens off;
    access_log /var/log/nginx/easysubway-edge.log easysubway_edge_json if=$easysubway_edge_loggable;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/easysubway-edge.log easysubway_edge_json if=$easysubway_edge_loggable;

    ssl_certificate /etc/letsencrypt/live/easysubway-api.aquilaxk.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/easysubway-api.aquilaxk.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets off;

    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name easysubway-api.aquilaxk.site;
    server_tokens off;
    access_log /var/log/nginx/easysubway-edge.log easysubway_edge_json if=$easysubway_edge_loggable;

    ssl_certificate /etc/letsencrypt/live/easysubway-api.aquilaxk.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/easysubway-api.aquilaxk.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets off;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 30s;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 20s;
    proxy_next_upstream off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include /etc/nginx/snippets/easysubway-real-ip.conf;
    limit_req_status 429;
    limit_conn_status 429;
    error_page 429 = @easysubway_rate_limited;

    location @easysubway_rate_limited {
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        default_type application/json;
        return 429 '{"code":"RATE_LIMITED"}';
    }

    # actuator 메트릭·엔드포인트는 공개 노출하지 않는다(#2376). 배포·관측 readiness/liveness probe
    # 경로만 예외로 공개 유지하고(공개 probe 계약 무회귀), 나머지 /actuator/* 는 차단한다.
    # Prometheus는 compose 네트워크에서 활성 K3s journey-active Service ClusterIP로 /actuator/prometheus 를 직접 scrape한다.
    location = /actuator/health/readiness {
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }

    location = /actuator/health/liveness {
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }

    location = /actuator {
        return 404;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location ^~ /api/v3/journeys/ {
        limit_req zone=easysubway_journey burst=10 nodelay;
        limit_conn easysubway_conn 25;
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }

    location ^~ /api/v1/report-uploads {
        client_max_body_size 10m;
        limit_req zone=easysubway_upload burst=5 nodelay;
        limit_conn easysubway_conn 10;
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }

    location ^~ /api/v1/reports {
        client_max_body_size 10m;
        limit_req zone=easysubway_upload burst=5 nodelay;
        limit_conn easysubway_conn 10;
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }

    location / {
        limit_req zone=easysubway_api burst=30 nodelay;
        limit_conn easysubway_conn 25;
        proxy_pass http://127.0.0.1:__BACKEND_PORT__;
        include /etc/nginx/snippets/easysubway-default-proxy.conf;
    }
}
