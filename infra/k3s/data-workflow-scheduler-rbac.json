          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "data-scheduler-deployer",
        "namespace": "easysubway-journey"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "data-scheduler-deployer",
